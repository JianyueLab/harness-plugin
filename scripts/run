#!/usr/bin/env sh
# Launcher for the usage reporter.
#
# Hooks run in whatever environment Claude Code was started with, which is not
# necessarily one where `bun` or `node` resolve the way an interactive shell
# would. Everything here is about finding a runtime and getting out of the way:
# the reporter is plain ESM on built-ins, so either runtime works.
#
# Never exits non-zero on a missing runtime. This plugin only does bookkeeping,
# and a machine without node has bigger problems than unreported token counts —
# surfacing a hook error on every turn would be the actual damage.
set -eu

ROOT="${CLAUDE_PLUGIN_ROOT:-$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)}"
ENTRY="$ROOT/src/reporter.mjs"

# A project-level NODE_OPTIONS (loaders, --experimental flags) is meant for that
# project's code, not for a plugin hook it knows nothing about.
if [ -n "${NODE_OPTIONS:-}" ]; then
  unset NODE_OPTIONS
fi

# Detached mode, for hosts whose hooks block the agent loop (agy). The payload
# is read here because the child cannot: this process owns stdin.
DETACH=0
ARGS=""
for arg in "$@"; do
  if [ "$arg" = "--detach" ]; then
    DETACH=1
  else
    ARGS="$ARGS $arg"
  fi
done

if [ "$DETACH" = "1" ]; then
  PAYLOAD=$(cat 2>/dev/null || true)
  # shellcheck disable=SC2086
  ( printf '%s' "$PAYLOAD" | "$0" $ARGS >/dev/null 2>&1 & ) </dev/null >/dev/null 2>&1
  printf '{}\n'
  exit 0
fi

if [ -n "${JYL_USAGE_RUNTIME:-}" ] && [ -x "${JYL_USAGE_RUNTIME}" ]; then
  exec "${JYL_USAGE_RUNTIME}" "$ENTRY" "$@"
fi

# bun first — it is the JianyueLab default and starts faster, which matters on a
# hook that fires after every turn.
if command -v bun >/dev/null 2>&1; then
  exec bun "$ENTRY" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$ENTRY" "$@"
fi

echo "jyl-usage: no bun or node on PATH; not reporting usage. Set JYL_USAGE_RUNTIME to an absolute path to override." >&2
exit 0
