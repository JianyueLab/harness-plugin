#!/usr/bin/env sh
# Launcher for the WakaTime reporter.
#
# Deliberately a second launcher rather than a flag on scripts/run: jyl-usage
# sends counts only, this one sends file paths. Two privacy postures sharing
# one entry point is how a shared config path and an accidental cross-import
# get introduced later.
#
# Never exits non-zero. This is bookkeeping; a harness run must not go red
# because a reporter could not find a runtime.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
ENTRY="$ROOT/src/wakatime/main.mjs"

# A project-level NODE_OPTIONS is meant for that project's code, not for a
# hook it knows nothing about.
if [ -n "${NODE_OPTIONS:-}" ]; then
  unset NODE_OPTIONS
fi

DETACH=0
ARGS=""
for arg in "$@"; do
  if [ "$arg" = "--detach" ]; then
    DETACH=1
  else
    ARGS="$ARGS $arg"
  fi
done

if [ "$DETACH" = "1" ]; then
  # The payload is read here because the child cannot: this process owns stdin.
  PAYLOAD=$(cat 2>/dev/null || true)
  # $ARGS is intentionally unquoted so it re-splits on whitespace. Safe because
  # the only caller is harness's [[hooks]] args, which carry no paths.
  # shellcheck disable=SC2086
  ( printf '%s' "$PAYLOAD" | "$0" $ARGS >/dev/null 2>&1 & ) </dev/null >/dev/null 2>&1
  exit 0
fi

if [ -n "${JYL_WAKATIME_RUNTIME:-}" ] && [ -x "${JYL_WAKATIME_RUNTIME}" ]; then
  exec "${JYL_WAKATIME_RUNTIME}" "$ENTRY" "$@"
fi

if command -v bun >/dev/null 2>&1; then
  exec bun "$ENTRY" "$@"
fi

if command -v node >/dev/null 2>&1; then
  exec node "$ENTRY" "$@"
fi

# harness discards a hook's stderr and only raises a Problem on a non-zero
# exit (this script never does that, on purpose) -- so the stderr line above
# is invisible from inside harness. Without this, "no runtime on PATH" is a
# silent, undiagnosable failure: --status run from a shell that *does* have
# bun on PATH looks perfectly healthy. Best-effort: a read-only $HOME must
# not turn "no runtime" into a non-zero exit.
#
# This path MUST stay byte-for-byte in sync with STATE_DIR in
# src/wakatime/cfg.mjs -- that JS constant is the single source of truth for
# where this tool's state lives, and this shell line only exists because the
# JS never got to run. It deliberately does NOT read $XDG_CONFIG_HOME:
# os.homedir() in cfg.mjs never does either, so a shell computation that did
# would silently write this fallback line to a directory --status never
# reads. If STATE_DIR ever becomes XDG-aware, this line has to move with it.
LOGDIR="$HOME/.config/jyl-wakatime"
mkdir -p "$LOGDIR" 2>/dev/null || true
printf '%s jyl-wakatime: no bun or node on PATH; not reporting\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >>"$LOGDIR/log" 2>/dev/null || true
echo "jyl-wakatime: no bun or node on PATH; not reporting. Set JYL_WAKATIME_RUNTIME to an absolute path to override." >&2
exit 0
